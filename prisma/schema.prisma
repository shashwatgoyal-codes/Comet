// Comet schema. docs/DATABASE.md is the source of truth; this file
// implements it and changes in the same commit as the doc.
//
// Prisma 7 takes no connection URL here. The app connects through a
// driver adapter (lib/db.ts) on Supabase's pooled endpoint; migrations
// use the direct endpoint, configured in prisma.config.ts.
//
// Every table also needs row-level security switched on (with no
// policies) in its migration, so Supabase's public REST API can't read
// it. tests/integration/rls.int.test.ts fails if any table is missed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

enum ThemePreference {
  system
  light
  dark

  @@map("theme_preference")
}

enum DemoRole {
  rider
  pilot

  @@map("demo_role")
}

/// One row per Supabase auth user; `id` equals auth.users.id.
///
/// There is deliberately no foreign key to auth.users. That table lives in
/// Supabase's own schema, which the throwaway Postgres used by CI doesn't
/// have, and a constraint the tests can't run against is one nobody can
/// trust. The link is kept by code: this row is created by the auth
/// service right after sign-in, and deleted alongside the auth user.
model User {
  id            String          @id @db.Uuid
  /// Public, permanent identifier: "CMT-" + 6 Crockford base32 characters.
  /// Never reused, never changed — see lib/comet-id.ts.
  cometId       String          @unique @map("comet_id") @db.Char(10)
  displayName   String          @map("display_name") @db.VarChar(60)
  email         String?         @unique @db.VarChar(254)
  avatarPath    String?         @map("avatar_path")
  /// Argon2id hash of the 4-digit safety PIN that ends an SOS. Never the PIN.
  safetyPinHash String?         @map("safety_pin_hash")
  isDemo        Boolean         @default(false) @map("is_demo")
  demoRole      DemoRole?       @map("demo_role")
  locale        String          @default("en") @db.VarChar(8)
  theme         ThemePreference @default(system)
  hideLastName  Boolean         @default(false) @map("hide_last_name")
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  riderProfile         RiderProfile?
  pilotProfile         PilotProfile?         @relation("PilotProfileUser")
  fareQuotes           FareQuote[]
  pilotLocation        PilotLocation?
  ridesAsRider         Ride[]                @relation("RideRider")
  ridesAsPilot         Ride[]                @relation("RidePilot")
  rideOffers           RideOffer[]
  walletEntries        WalletEntry[]
  payments             Payment[]
  payouts              Payout[]
  ratingsGiven         Rating[]              @relation("RatingRater")
  shareLinks           ShareLink[]
  sosRaised            SosAlert[]            @relation("SosRaisedBy")
  identityVerification IdentityVerification?
  savedPlaces          SavedPlace[]
  emergencyContacts    EmergencyContact[]
  promoRedemptions     PromoRedemption[]
  ratingsGot           Rating[]              @relation("RatingRatee")

  @@index([isDemo, createdAt], map: "users_demo_created_idx")
  @@map("users")
}

enum WomenOnlyMode {
  off
  always
  night

  @@map("women_only_mode")
}

enum WomenOnlyFallback {
  ask
  wait

  @@map("women_only_fallback")
}

enum PilotStatus {
  pending
  approved
  rejected
  suspended

  @@map("pilot_status")
}

enum VehicleType {
  bike
  auto
  car

  @@map("vehicle_type")
}

enum RideTier {
  bike
  auto
  go
  prime

  @@map("ride_tier")
}

// ------------------------------------------------------------------ quotes

/// A priced route, locked for 5 minutes so the fare shown is the fare
/// charged (docs/PRD.md F3). Coordinates are plain lat/lng here: quotes
/// are looked up by id, never searched spatially, so they don't need
/// PostGIS (pilot_locations will).
model FareQuote {
  id               String   @id @default(uuid()) @db.Uuid
  riderId          String   @map("rider_id") @db.Uuid
  pickupAddress    String   @map("pickup_address") @db.VarChar(200)
  pickupLat        Float    @map("pickup_lat")
  pickupLng        Float    @map("pickup_lng")
  dropAddress      String   @map("drop_address") @db.VarChar(200)
  dropLat          Float    @map("drop_lat")
  dropLng          Float    @map("drop_lng")
  distanceM        Int      @map("distance_m")
  durationS        Int      @map("duration_s")
  /// GeoJSON LineString coordinates, [lng, lat] pairs.
  routeCoordinates Json     @map("route_coordinates")
  /// True when routing was unavailable and the distance is an estimate.
  isEstimate       Boolean  @default(false) @map("is_estimate")
  /// Total fare per tier in paise: { bike, auto, go, prime }.
  prices           Json
  surge            Decimal  @default(1.00) @db.Decimal(3, 2)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  rider User @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, createdAt(sort: Desc)], map: "fare_quotes_rider_created_idx")
  @@map("fare_quotes")
}

/// Created the first time someone uses the rider app.
model RiderProfile {
  userId            String            @id @map("user_id") @db.Uuid
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratingAvg         Decimal?          @map("rating_avg") @db.Decimal(3, 2)
  ratingCount       Int               @default(0) @map("rating_count")
  /// Demo only: a bot Pilot accepts this rider's rides if no real Pilot does.
  /// Riders switch it off to test with a real Pilot demo in another tab.
  simulatedPilot    Boolean           @default(true) @map("simulated_pilot")
  womenOnlyMode     WomenOnlyMode     @default(off) @map("women_only_mode")
  womenOnlyFallback WomenOnlyFallback @default(ask) @map("women_only_fallback")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("rider_profiles")
}

/// A Pilot. Vehicle details are nullable while onboarding is in progress;
/// a database check requires them all before status can be "approved".
model PilotProfile {
  userId              String        @id @map("user_id") @db.Uuid
  user                User          @relation("PilotProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  status              PilotStatus   @default(pending)
  vehicleType         VehicleType?  @map("vehicle_type")
  tier                RideTier?
  vehicleModel        String?       @map("vehicle_model") @db.VarChar(60)
  vehicleColour       String?       @map("vehicle_colour") @db.VarChar(30)
  plate               String?       @db.VarChar(16)
  seats               Int?
  ratingAvg           Decimal?      @map("rating_avg") @db.Decimal(3, 2)
  ratingCount         Int           @default(0) @map("rating_count")
  womenPassengersMode WomenOnlyMode @default(off) @map("women_passengers_mode")
  /// A bot Pilot that drives demo rides (docs/ARCHITECTURE.md §9).
  isSimulated         Boolean       @default(false) @map("is_simulated")
  /// The demo rider this bot serves; null for ambient bots and real Pilots.
  simulatedForUserId  String?       @map("simulated_for_user_id") @db.Uuid
  approvedAt          DateTime?     @map("approved_at") @db.Timestamptz
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([simulatedForUserId], map: "pilot_profiles_simulated_for_idx")
  @@map("pilot_profiles")
}

// ------------------------------------------------------------ live Pilots

/// One row per Pilot, updated in place every few seconds while online.
/// The only PostGIS column in the schema: matching searches it by distance
/// (GIST index in the migration). Written and read with raw SQL.
model PilotLocation {
  pilotId       String                                @id @map("pilot_id") @db.Uuid
  locationPoint Unsupported("geography(Point, 4326)") @map("location_point")
  headingDeg    Float?                                @map("heading_deg")
  speedKmh      Float?                                @map("speed_kmh")
  isOnline      Boolean                               @default(false) @map("is_online")
  /// False while the Pilot is on a ride, so they get no new offers.
  isAvailable   Boolean                               @default(true) @map("is_available")
  updatedAt     DateTime                              @default(now()) @map("updated_at") @db.Timestamptz

  pilot User @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@map("pilot_locations")
}

// ------------------------------------------------------------------ rides

enum RideStatus {
  scheduled
  requested
  accepted
  arrived
  in_progress
  completed
  cancelled
  expired
  no_show

  @@map("ride_status")
}

enum PaymentMethod {
  wallet
  upi
  card
  cash

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  waived

  @@map("payment_status")
}

enum CancelledBy {
  rider
  pilot
  system

  @@map("cancelled_by")
}

enum ActorRole {
  rider
  pilot
  system
  ops

  @@map("actor_role")
}

enum OfferStatus {
  offered
  accepted
  declined
  expired
  taken

  @@map("offer_status")
}

/// A ride. Status changes only along lib/ride-state.ts, enforced again by a
/// trigger in the database; every change is recorded in ride_events.
model Ride {
  id                   String        @id @default(uuid()) @db.Uuid
  riderId              String        @map("rider_id") @db.Uuid
  pilotId              String?       @map("pilot_id") @db.Uuid
  quoteId              String        @map("quote_id") @db.Uuid
  tier                 RideTier
  status               RideStatus    @default(requested)
  pickupAddress        String        @map("pickup_address") @db.VarChar(200)
  pickupLat            Float         @map("pickup_lat")
  pickupLng            Float         @map("pickup_lng")
  dropAddress          String        @map("drop_address") @db.VarChar(200)
  dropLat              Float         @map("drop_lat")
  dropLng              Float         @map("drop_lng")
  routeCoordinates     Json          @map("route_coordinates")
  distanceM            Int           @map("distance_m")
  durationS            Int           @map("duration_s")
  farePaise            Int           @map("fare_paise")
  discountPaise        Int           @default(0) @map("discount_paise")
  /// Wallet cashback earned from a promo, credited once the ride is paid by wallet.
  cashbackPaise        Int           @default(0) @map("cashback_paise")
  promoId              String?       @map("promo_id") @db.Uuid
  waitingFeePaise      Int           @default(0) @map("waiting_fee_paise")
  cancellationFeePaise Int           @default(0) @map("cancellation_fee_paise")
  totalPaise           Int           @map("total_paise")
  /// Comet's 15% of the fare, fixed at booking (splitFare in lib/fares.ts).
  platformFeePaise     Int           @default(0) @map("platform_fee_paise")
  /// Added by the rider when rating; paid from their wallet, 100% to the Pilot.
  tipPaise             Int           @default(0) @map("tip_paise")
  paymentMethod        PaymentMethod @map("payment_method")
  paymentStatus        PaymentStatus @default(pending) @map("payment_status")
  /// The 4-digit code the rider gives the Pilot to start the trip. Only
  /// ever returned to the rider (docs/DATABASE.md §10).
  rideCode             String        @map("ride_code") @db.Char(4)
  rideCodeAttempts     Int           @default(0) @map("ride_code_attempts")
  womenOnly            Boolean       @default(false) @map("women_only")
  /// For a ride booked ahead: the pickup time. It's offered to Pilots 15
  /// minutes before (lib/scheduling.ts).
  scheduledFor         DateTime?     @map("scheduled_for") @db.Timestamptz
  isDemo               Boolean       @default(false) @map("is_demo")
  simulationStartedAt  DateTime?     @map("simulation_started_at") @db.Timestamptz
  requestedAt          DateTime      @default(now()) @map("requested_at") @db.Timestamptz
  acceptedAt           DateTime?     @map("accepted_at") @db.Timestamptz
  arrivedAt            DateTime?     @map("arrived_at") @db.Timestamptz
  startedAt            DateTime?     @map("started_at") @db.Timestamptz
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelledBy          CancelledBy?  @map("cancelled_by")
  cancelReason         String?       @map("cancel_reason") @db.VarChar(200)
  city                 String        @default("blr") @db.VarChar(8)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  rider         User             @relation("RideRider", fields: [riderId], references: [id], onDelete: Restrict)
  pilot         User?            @relation("RidePilot", fields: [pilotId], references: [id], onDelete: Restrict)
  offers        RideOffer[]
  events        RideEvent[]
  shareLinks    ShareLink[]
  sosAlerts     SosAlert[]
  promo         PromoCode?       @relation(fields: [promoId], references: [id], onDelete: Restrict)
  redemption    PromoRedemption?
  walletEntries WalletEntry[]
  payments      Payment[]
  ratings       Rating[]

  @@index([riderId, requestedAt(sort: Desc)], map: "rides_rider_requested_idx")
  @@index([pilotId, completedAt(sort: Desc)], map: "rides_pilot_completed_idx")
  @@map("rides")
}

/// A ride offered to one Pilot. A wave offers up to 3 Pilots at once; the
/// first accept wins and the others become "taken".
model RideOffer {
  id          String      @id @default(uuid()) @db.Uuid
  rideId      String      @map("ride_id") @db.Uuid
  pilotId     String      @map("pilot_id") @db.Uuid
  wave        Int
  status      OfferStatus @default(offered)
  offeredAt   DateTime    @default(now()) @map("offered_at") @db.Timestamptz
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz
  respondedAt DateTime?   @map("responded_at") @db.Timestamptz

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  pilot User @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([rideId, pilotId], map: "ride_offers_ride_pilot_key")
  @@map("ride_offers")
}

/// Append-only audit trail of every ride state change (a trigger rejects
/// UPDATE and DELETE).
model RideEvent {
  id        String    @id @default(uuid()) @db.Uuid
  rideId    String    @map("ride_id") @db.Uuid
  type      String    @db.VarChar(40)
  actorId   String?   @map("actor_id") @db.Uuid
  actorRole ActorRole @map("actor_role")
  data      Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt], map: "ride_events_ride_created_idx")
  @@map("ride_events")
}

// ------------------------------------------------------------------ money

enum WalletEntryKind {
  topup
  ride_payment
  ride_refund
  cancellation_fee
  waiting_fee
  tip
  referral_reward
  cashback
  pilot_earning
  platform_fee
  payout
  cash_change
  demo_grant
  promo_subsidy

  @@map("wallet_entry_kind")
}

enum PaymentPurpose {
  topup
  ride

  @@map("payment_purpose")
}

enum PaymentRecordStatus {
  created
  paid
  failed

  @@map("payment_record_status")
}

enum PayoutStatus {
  requested
  paid

  @@map("payout_status")
}

/// The money ledger (docs/DATABASE.md "Money"). Append-only: a trigger
/// rejects UPDATE and DELETE. A balance is SUM(amount_paise). Balance-
/// checked writes go through the plpgsql functions in the wallet migration.
model WalletEntry {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  /// Signed: credits positive, debits negative, never zero.
  amountPaise    Int             @map("amount_paise")
  kind           WalletEntryKind
  rideId         String?         @map("ride_id") @db.Uuid
  paymentId      String?         @map("payment_id") @db.Uuid
  /// One entry per real-world event, however many times it's retried.
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(120)
  note           String?         @db.VarChar(200)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  ride    Ride?    @relation(fields: [rideId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)], map: "wallet_entries_user_created_idx")
  @@map("wallet_entries")
}

/// Razorpay orders (test mode). A wallet credit or ride payment happens
/// only once a payment against the order is verified.
model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  purpose           PaymentPurpose
  rideId            String?             @map("ride_id") @db.Uuid
  amountPaise       Int                 @map("amount_paise")
  razorpayOrderId   String              @unique @map("razorpay_order_id") @db.VarChar(64)
  razorpayPaymentId String?             @unique @map("razorpay_payment_id") @db.VarChar(64)
  status            PaymentRecordStatus @default(created)
  failureReason     String?             @map("failure_reason") @db.VarChar(200)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ride          Ride?         @relation(fields: [rideId], references: [id], onDelete: Restrict)
  walletEntries WalletEntry[]

  @@index([userId, createdAt(sort: Desc)], map: "payments_user_created_idx")
  @@map("payments")
}

/// Simulated Pilot withdrawals. No money leaves Comet.
model Payout {
  id          String       @id @default(uuid()) @db.Uuid
  pilotId     String       @map("pilot_id") @db.Uuid
  amountPaise Int          @map("amount_paise")
  status      PayoutStatus @default(requested)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  paidAt      DateTime?    @map("paid_at") @db.Timestamptz

  pilot User @relation(fields: [pilotId], references: [id], onDelete: Restrict)

  @@index([pilotId, createdAt(sort: Desc)], map: "payouts_pilot_created_idx")
  @@map("payouts")
}

/// One rating per ride per side (docs/DATABASE.md "ratings"). Written by
/// comet_rate_ride together with the ratee's average and any tip.
model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @map("ride_id") @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  stars     Int      @db.SmallInt
  tags      String[] @default([])
  comment   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ride  Ride @relation(fields: [rideId], references: [id], onDelete: Restrict)
  rater User @relation("RatingRater", fields: [raterId], references: [id], onDelete: Restrict)
  ratee User @relation("RatingRatee", fields: [rateeId], references: [id], onDelete: Restrict)

  @@unique([rideId, raterId], map: "ratings_ride_rater_key")
  @@index([rateeId, createdAt(sort: Desc)], map: "ratings_ratee_created_idx")
  @@map("ratings")
}

// ----------------------------------------------------------------- safety

enum SosRole {
  rider
  pilot

  @@map("sos_role")
}

enum SosReason {
  rider_unsafe
  accident
  medical
  vehicle
  other

  @@map("sos_reason")
}

enum SosStatus {
  open
  acknowledged
  resolved

  @@map("sos_status")
}

/// "Share trip" links (docs/DATABASE.md "share_links"). Only the SHA-256 of
/// the token is stored; the token itself exists only in the link.
model ShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  rideId    String    @map("ride_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ride    Ride @relation(fields: [rideId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([rideId], map: "share_links_ride_idx")
  @@map("share_links")
}

/// SOS alerts (docs/DATABASE.md "sos_alerts"). Raising one is never blocked;
/// ending it needs the raiser's safety PIN.
model SosAlert {
  id             String     @id @default(uuid()) @db.Uuid
  rideId         String     @map("ride_id") @db.Uuid
  raisedBy       String     @map("raised_by") @db.Uuid
  raisedByRole   SosRole    @map("raised_by_role")
  reason         SosReason?
  status         SosStatus  @default(open)
  assignedTo     String?    @map("assigned_to") @db.Uuid
  lastLat        Float?     @map("last_lat")
  lastLng        Float?     @map("last_lng")
  resolutionNote String?    @map("resolution_note") @db.VarChar(500)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  acknowledgedAt DateTime?  @map("acknowledged_at") @db.Timestamptz
  resolvedAt     DateTime?  @map("resolved_at") @db.Timestamptz

  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Restrict)
  raiser User @relation("SosRaisedBy", fields: [raisedBy], references: [id], onDelete: Restrict)

  @@index([raisedBy, createdAt(sort: Desc)], map: "sos_alerts_raiser_idx")
  @@map("sos_alerts")
}

enum VerificationMethod {
  simulated

  @@map("verification_method")
}

/// The women-only verification (docs/DATABASE.md "identity_verifications").
/// Stores the outcome only, never documents. In Comet it's simulated: a
/// real service (DigiLocker, an ID check) would set it. Only the
/// verification service writes it; it's never a profile field.
model IdentityVerification {
  userId         String             @id @map("user_id") @db.Uuid
  verifiedFemale Boolean            @map("verified_female")
  method         VerificationMethod
  verifiedAt     DateTime           @default(now()) @map("verified_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("identity_verifications")
}

// --------------------------------------------------------------- account

enum PlaceLabel {
  home
  work
  other

  @@map("place_label")
}

/// "14 · Saved places". At most one Home and one Work per user (partial
/// unique indexes in the migration); deleted with the user.
model SavedPlace {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  label     PlaceLabel
  name      String     @db.VarChar(60)
  address   String     @db.VarChar(200)
  lat       Float
  lng       Float
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "saved_places_user_idx")
  @@map("saved_places")
}

/// Emergency contacts (docs/DATABASE.md). Comet never calls or messages
/// them — SOS contacts no real person (docs/PRD.md §7). Only the owner
/// reads them; never shown to Pilots, riders or the share page.
model EmergencyContact {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(60)
  phoneE164 String   @map("phone_e164") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "emergency_contacts_user_idx")
  @@map("emergency_contacts")
}

// ----------------------------------------------------------------- promos

enum PromoKind {
  flat
  percent
  cashback

  @@map("promo_kind")
}

/// Promo codes (docs/DATABASE.md "Promotions"). value is paise for flat,
/// basis points for percent and cashback. Comet funds every discount; the
/// Pilot always earns the full fare.
model PromoCode {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique @db.VarChar(20)
  kind             PromoKind
  value            Int
  maxDiscountPaise Int?      @map("max_discount_paise")
  minFarePaise     Int       @default(0) @map("min_fare_paise")
  tier             RideTier?
  walletOnly       Boolean   @default(false) @map("wallet_only")
  title            String    @db.VarChar(120)
  startsAt         DateTime  @map("starts_at") @db.Timestamptz
  endsAt           DateTime  @map("ends_at") @db.Timestamptz
  maxUsesPerUser   Int       @default(1) @map("max_uses_per_user")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  rides       Ride[]
  redemptions PromoRedemption[]

  @@map("promo_codes")
}

/// One per ride that used a promo. A cancelled or expired ride gives the
/// use back (it isn't counted).
model PromoRedemption {
  id            String   @id @default(uuid()) @db.Uuid
  promoId       String   @map("promo_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  rideId        String   @unique @map("ride_id") @db.Uuid
  discountPaise Int      @map("discount_paise")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  promo PromoCode @relation(fields: [promoId], references: [id], onDelete: Restrict)
  user  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  ride  Ride      @relation(fields: [rideId], references: [id], onDelete: Restrict)

  @@index([userId, promoId], map: "promo_redemptions_user_promo_idx")
  @@map("promo_redemptions")
}
